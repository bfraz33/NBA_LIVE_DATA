# ---- Tank01 via RapidAPI (required unless using --demo) ----
NBA_API_KEY=your_rapidapi_key_here

# ---- Polling ----
POLL_INTERVAL_SECONDS=180
TIMEZONE=America/Chicago
POLL_START_HOUR=8
POLL_END_HOUR=24
# PREFERRED_BOOK=fanduel

# ---- Postgres (optional; enable with DB_ENABLED=true or --db) ----
DB_ENABLED=false
DB_NAME=FrontOffice
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# ---- AWS IoT Core (optional; enable with AWS_ENABLED=true or --aws) ----
AWS_ENABLED=false
ENDPOINT=xxxxxxxxxxxx-ats.iot.us-east-2.amazonaws.com
REGION=us-east-2
NBA_CLIENT_ID=nba-publisher-ec2
NBA_TOPIC=nba/live/scores
